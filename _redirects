# Keep the home-page URL singular.
/index.html           /                       301

# Redirect all www to non-www
https://www.shrishtravels.netlify.app/* https://shrishtravels.netlify.app/:splat 301!

# Sitemap access
/sitemap.xml      /sitemap.xml    200

# Optional cleanup redirects
/%7Bignore%7D     /               301
/{ignore}         /               301

# Redirect old pages to new equivalents (301 = Permanent Move)
/packages.html         /routes.html           301
/about-us.html         /about.html            301
/contact-us.html       /contact.html          301
/terms.html            /terms-of-service.html 301

# Return a real 404 response for unknown paths. Serving the home page here created
# soft-404 URLs that could be crawled as duplicate content.
/* /404.html              404
